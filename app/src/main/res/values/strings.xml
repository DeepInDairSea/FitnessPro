    <string name="app_name">Fitness Pro</string>

    <!-- Health Connect 权限说明页（Android 14+ 要求必须提供） -->
    <string name="hc_rationale_title">为什么需要读取体重</string>
    <string name="hc_rationale_body">Fitness Pro 是一个本地优先的训练记录应用。读取体重数据只有一个用途：把你的体重记录同步进"身体数据"页，用于自重动作的容量计算与体重趋势图。数据只保存在你的手机上，不会被上传或分享。</string>
    <string name="hc_rationale_close">我知道了</string>

    <!-- Onboarding -->
    <string name="onboarding_title_1">把训练记下来</string>
    <string name="onboarding_body_1">为每个动作记录组数、次数与重量，自动计算容量、估算 1RM 并检测个人纪录。</string>
    <string name="onboarding_title_2">本地优先，数据属于你</string>
    <string name="onboarding_body_2">所有数据只保存在这台手机上。没有账号，没有上传。随时可以一键导出完整备份。</string>
    <string name="onboarding_title_3">休息计时，不怕切走</string>
    <string name="onboarding_body_3">组间休息通过系统通知倒计时，切到别的应用、锁屏甚至杀掉应用，计时都不会丢。</string>
