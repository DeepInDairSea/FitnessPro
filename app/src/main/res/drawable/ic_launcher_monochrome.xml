<?xml version="1.0" encoding="utf-8"?>
<!--
  主题图标（Android 13+ 单色图标）用的轮廓：折线 + 圆环 + 三个节点。
  只保留图形部分，颜色由系统统一染色，因此这里画黑色即可。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主折线：从左下升起 → 中段下凹 → 右上收进圆环 -->
    <path
        android:pathData="M30,76 C36,64 42,60 47,66 C51,71 55,66 61,55"
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 圆环（训练闭环） -->
    <path
        android:pathData="M68,45 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeColor="#FF000000"
        android:strokeWidth="5.5" />

    <path
        android:pathData="M47,66 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FF000000" />
    <path
        android:pathData="M61,55 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FF000000" />
    <path
        android:pathData="M68,37 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
        android:fillColor="#FF000000" />
</vector>
