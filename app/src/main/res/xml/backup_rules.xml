<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的备份规则，与 data_extraction_rules.xml 保持一致 -->
<full-backup-content>
    <exclude domain="file" path="media" />
    <exclude domain="file" path="thumbs" />
    <exclude domain="file" path="capture" />
    <exclude domain="external" path="." />
</full-backup-content>
